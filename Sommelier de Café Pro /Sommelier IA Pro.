st.markdown("### 📜 Seu Histórico de Degustações desta Sessão")

if st.session_state.historico_degustacoes:
    # Transforma nossa lista de dicionários em uma tabela estruturada do Pandas DataFrame
    df_historico = pd.DataFrame(st.session_state.historico_degustacoes)
    
    # Exibe a tabela de forma bonita e interativa na interface web
    st.dataframe(
        df_historico, 
        use_container_width=True,
        hide_index=True  # Esconde a coluna de números automáticos (0, 1, 2...)
