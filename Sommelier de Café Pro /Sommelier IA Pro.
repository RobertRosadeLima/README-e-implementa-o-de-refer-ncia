import streamlit as st
import google.genai as genai
from PIL import Image
import pandas as pd  # Biblioteca padrão de mercado para criar tabelas de dados

# 1. CONFIGURAÇÃO DA PÁGINA WEB
st.set_page_config(page_title="Sommelier IA Pro", page_icon="☕", layout="centered")

st.title("☕ Sommelier de Café Pro com Histórico")
st.markdown("Envie uma foto e a descrição do seu café para análise. Suas degustações ficarão salvas na tabela abaixo!")

# NOVO: Inicializa a lista de histórico na memória da sessão se ela ainda não existir
if "historico_degustacoes" not in st.session_state:
    st.session_state.historico_degustacoes = []

# 2. CONEXÃO SEGURA COM A IA
try:
    CHAVE_SEGURA = st.secrets["GEMINI_API_KEY"]
    client = genai.Client(api_key=CHAVE_SEGURA)
except Exception:
    st.error("❌ Erro de Configuração: A chave 'GEMINI_API_KEY' não foi encontrada nas Secrets.")
    st.stop()

# 3. INTERFACE DE ENTRADA DE DADOS
nome_grao = st.text_input("Qual o nome ou marca do café?")
nota = st.slider("De 1 a 5, qual nota você dá?", min_value=1, max_value=5, value=3)
comentario = st.text_area("Descreva o sabor ou o método de preparo:")

foto_cafe = st.file_uploader("📸 Envie uma foto do grão, pó ou da embalagem (Opcional)", type=["jpg", "jpeg", "png"])

if foto_cafe is not None:
    imagem_aberta = Image.open(foto_cafe)
    st.image(imagem_aberta, caption="Sua foto carregada com sucesso!", use_container_width=True)

# 4. BOTÃO DE ENVIO E PROCESSAMENTO MULTIMODAL
if st.button("Analisar Café com Visão Computacional 🚀"):
    if nome_grao and comentario:
        with st.spinner("🤖 O Sommelier de IA está analisando tudo..."):
            
            conteudos_para_envio = []
            if foto_cafe is not None:
                conteudos_para_envio.append(imagem_aberta)
                
            prompt = f"""
            Você é um Sommelier de Café especialista e descontraído. 
            Um usuário degustou o seguinte café:
            - Nome/Marca: {nome_grao}
            - Nota dada: {nota}/5
            - Comentário do usuário: {comentario}

            Gere um veredito técnico e divertido de até 3 linhas sobre essa experiência.
            """
            conteudos_para_envio.append(prompt)
            
            try:
                resposta = client.models.generate_content(
                    model='gemini-2.5-flash',
                    contents=conteudos_para_envio,
                )
                
                # Exibindo o resultado atual imediato na tela
                st.success("📊 ANÁLISE DO SOMMELIER IA")
                st.metric(label=f"Avaliação do {nome_grao}", value="⭐" * nota)
                st.write(resposta.text)
                
                # NOVO: Adicionando esta degustação na nossa lista de histórico
                st.session_state.historico_degustacoes.append({
                    "Café/Marca": nome_grao,
                    "Nota": "⭐" * nota,
                    "Seu Comentário": comentario,
                    "Veredito da IA": resposta.text
                })
                
            except Exception as e:
                st.error(f"Erro ao processar a resposta da IA: {e}")
    else:
        st.warning("⚠️ Por favor, preencha o nome do grão e o comentário antes de analisar.")

