app = FastAPI(title="API de Agente de Reembolsos")

# Configuração do Banco de Dados Assíncrono (Recomendado para FastAPI)
DB_URI = "postgresql://usuario:senha@localhost:5432/nome_do_banco"
pool = AsyncConnectionPool(conninfo=DB_URI, max_size=10, open=False)

# Variável global para armazenar o grafo compilado assincronamente
grafo_app = None

@app.on_event("startup")
async def startup_event():
    global grafo_app
    # Inicializa a pool do banco de dados ao iniciar o servidor
    await pool.open()
    
    # Configura o checkpointer assíncrono do Postgres
    async with pool.connection() as conn:
        checkpointer = AsyncPostgresSaver(conn)
        await checkpointer.setup()
        
        # Compila o grafo usando o checkpointer persistente
        # (interrupt_before garante a pausa para aprovação humana)
        grafo_app = workflow.compile(
            checkpointer=checkpointer,
            interrupt_before=["human_gate"]
        )

@app.on_event("shutdown")
async def shutdown_event():
    await pool.close()

# --- MODELOS DE ENTRADA (PAYLOADS) ---
class ChatInput(BaseModel):
    thread_id: str
    mensagem: str

class AprovacaoInput(BaseModel):
    thread_id: str
    autorizado: bool

# --- ROTAS DA API ---

@app.post("/chat/stream")
async def chat_stream(payload: ChatInput):
    """Rota que executa o agente e devolve a resposta em tempo real (Streaming)."""
    
    config = {"configurable": {"thread_id": payload.thread_id}}
    input_usuario = {"messages": [("user", payload.mensagem)]}
    
    async def gerador_de_eventos():
        # Executa o grafo de forma assíncrona e em streaming de eventos
        async for evento in grafo_app.astream(input_usuario, config):
            for nó, dados in evento.items():
                # Se o nó gerou mensagens, envia a última mensagem de texto de volta
                if "messages" in dados and dados["messages"]:
                    ultima_msg = dados["messages"][-1]
                    
                    # Formata o evento no padrão Server-Sent Events (SSE)
                    yield {
                        "event": "message",
                        "data": json.dumps({
                            "no": nó,
                            "texto": ultima_msg.content,
                            "status": dados.get("status", "PROCESSANDO")
                        })
                    }
        
        # Verifica se o grafo pausou aguardando ação humana após o stream acabar
        estado_atual = await grafo_app.aget_state(config)
        if estado_atual.next:
            yield {
                "event": "checkpoint",
                "data": json.dumps({
                    "status": "PAUSADO_AGUARDANDO_APROVACAO",
                    "valor": estado_atual.values.get("valor_extraido"),
                    "categoria": estado_atual.values.get("categoria")
                })
            }

    return EventSourceResponse(gerador_de_eventos())


@app.post("/chat/aprovar")
async def aprovar_reembolso(payload: AprovacaoInput):
    """Rota chamada pelo sistema externo (ex: painel do gestor) para liberar ou barrar o fluxo."""
    config = {"configurable": {"thread_id": payload.thread_id}}
    estado_atual = await grafo_app.aget_state(config)
    
    if not estado_atual.next:
        raise HTTPException(status_code=400, detail="Este agente não está pausado ou aguardando aprovação.")
        
    if payload.autorizado:
        # Se autorizado, enviamos None no input para o LangGraph continuar de onde parou
        resultado = await grafo_app.ainvoke(None, config)
        return {"status": "sucesso", "mensagem": "Fluxo retomado e aprovado com sucesso.", "estado_final": resultado.get("status")}
    else:
        # Se rejeitado, podemos atualizar o estado manualmente para REJEITADO e encerrar
        await grafo_app.aupdate_state(config, {"status": "REJEITADO"}, as_node="human_gate")
        return {"status": "sucesso", "mensagem": "Reembolso rejeitado pelo gestor."}

