@tool
def calcular_imposto_produto(preco_base: float, categoria: str) -> float:
    """Calcula o imposto de um produto com base no preço e na categoria. 
    Use esta ferramenta sempre que precisar saber o valor final taxado."""
 categoria = categoria.lower()
