from typing import Annotated, Literal
from typing_extensions import TypedDict
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from langgraph.prebuilt import ToolNode

# 1. Definindo o Estado (State)
# O Estado define o que o grafo vai "lembrar" durante a execução. 
# Aqui, usamos uma lista de mensagens que cresce a cada interação (add_messages).
class AgentState(TypedDict):
    messages: Annotated[list, add_messages]

# 2. Definindo os Nós (Nodes)

# Nó do Agente: Chama o Gemini passando o histórico de mensagens
def chatbot(state: AgentState):
    # Vincula as ferramentas ao LLM (garantindo que ele saiba usá-las)
    llm_with_tools = llm.bind_tools(tools)
    resposta = llm_with_tools.invoke(state["messages"])
    return {"messages": [resposta]}

# Nó de Ferramentas: O LangGraph possui um utilitário nativo (ToolNode) 
# que executa automaticamente as funções quando o LLM solicita.
tool_node = ToolNode(tools)

# 3. Definindo a Lógica de Roteamento (Conditional Edge)
# Esta função olha para a última mensagem do modelo e decide para onde ir.
def rotear_resposta(state: AgentState) -> Literal["tools", END]:
    ultima_mensagem = state["messages"][-1]
    # Se o modelo gerou requisições de ferramentas (tool_calls), vai para o nó "tools"
    if ultima_mensagem.tool_calls:
        return "tools"
    # Se não, o agente terminou de responder e encerra o fluxo
    return END

# 4. Construindo o Grafo
workflow = StateGraph(AgentState)

# Adiciona os nós ao fluxo
workflow.add_node("agent", chatbot)
workflow.add_node("tools", tool_node)

# Define a entrada do fluxo: o grafo sempre começa chamando o agente
workflow.add_edge(START, "agent")

# Define a borda condicional: após o agente responder, o grafo roda a função de roteamento
workflow.add_conditional_edges(
    "agent",
    rotear_resposta,
)

# Define o retorno: após rodar as ferramentas, o fluxo volta para o agente avaliar o resultado
workflow.add_edge("tools", "agent")

# Compila o grafo para transformá-lo em uma aplicação executável
app = workflow.compile()

# Mensagem inicial do usuário
