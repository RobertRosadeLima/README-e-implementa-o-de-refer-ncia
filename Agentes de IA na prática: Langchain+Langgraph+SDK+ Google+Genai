# 2. DEFINIÇÃO DO ESTADO CUSTOMIZADO (STATE)
class ReembolsoState(TypedDict):
    messages: Annotated[list, add_messages]
    status: str            # "ANALISANDO", "APROVADO_AUTO", "PENDENTE_APROVACAO_HUMANA", "REJEITADO"
    valor_extraido: float
    categoria: str
    limite_permitido: float

# 3. SCHEMA DE EXTRAÇÃO COM PYDANTIC (STRUCTURED OUTPUT)
class AnaliseRecibo(BaseModel):
    valor_extraido: float = Field(description="O valor total em reais identificado no recibo ou no texto informado.")
    categoria: str = Field(description="A categoria da despesa. Deve ser estritamente uma destas: Alimentacao, Transporte, Hospedagem, Eletronicos.")
    justificativa: str = Field(description="Breve resumo descritivo do item comprado.")

# 4. POLÍTICA DA EMPRESA (REGRA DE NEGÓCIO)
def obter_limite_politica(categoria: str) -> float:
    """Regra de negócio pura em Python para mapear limites de reembolso."""
    politica = {
        "alimentacao": 100.0,
        "transporte": 150.0,
        "hospedagem": 500.0,
        "eletronicos": 0.0 # Eletrônicos nunca são aprovados automaticamente
    }
    return politica.get(categoria.lower(), 0.0)

# 5. DEFINIÇÃO DOS NÓS DO GRAFO (NODES)

def no_agente_analisador(state: ReembolsoState):
    """Nó 1: O Gemini lê os inputs (texto/imagem) e extrai os dados estruturados."""
    llm_estruturado = llm.with_structured_output(AnaliseRecibo)
    
    # Passa o histórico de mensagens para a IA extrair os dados
    dados = llm_estruturado.invoke(state["messages"])
    
    log_msg = AIMessage(
        content=f"[Agente] Detectado: R$ {dados.valor_extraido} na categoria '{dados.categoria}'. (Item: {dados.justificativa})"
    )
    
    return {
        "messages": [log_msg],
        "valor_extraido": dados.valor_extraido,
        "categoria": dados.categoria,
        "status": "ANALISANDO"
    }

def no_validar_politica(state: ReembolsoState):
    """Nó 2: Valida as regras financeiras da empresa baseando-se no que a IA extraiu."""
    valor = state["valor_extraido"]
    categoria = state["categoria"]
    limite = obter_limite_politica(categoria)
    
    if categoria.lower() == "eletronicos":
        status_final = "PENDENTE_APROVACAO_HUMANA"
        msg = AIMessage(content="[Sistema] Política: Categoria 'Eletrônicos' exige auditoria obrigatória.")
    elif valor <= limite:
        status_final = "APROVADO_AUTO"
        msg = AIMessage(content=f"[Sistema] Política: R$ {valor} está dentro do limite de R$ {limite} para {categoria}. Aprovado!")
    else:
        status_final = "PENDENTE_APROVACAO_HUMANA"
        msg = AIMessage(content=f"[Sistema] Política: R$ {valor} excede o limite de R$ {limite} para {categoria}. Retendo para aprovação.")
        
    return {
        "messages": [msg],
        "limite_permitido": limite,
        "status": status_final
    }

def no_aprovacao_humana(state: ReembolsoState):
    """Nó 3: Este nó serve apenas como o marcador de pausa para a intervenção humana."""
    # O código Python do fluxo principal vai interceptar o fluxo antes de executar este nó.
    # Quando o humano autorizar, o fluxo passa por aqui e define o status final.
    return {
        "messages": [AIMessage(content="[Gestor] O reembolso foi avaliado e aprovado manualmente pelo gestor.")],
        "status": "APROVADO_MANUAL"
    }

# 6. LÓGICA DE ROTEAMENTO (CONDITIONAL EDGES)

def rotear_pos_analise(state: ReembolsoState) -> Literal["validar_politica", END]:
    """Decide se precisamos ir para a validação (sempre vai após a análise inicial)."""
    return "validar_politica"

def rotear_pos_politica(state: ReembolsoState) -> Literal["human_gate", END]:
    """Roteador inteligente: Se cair em revisão humana, move para o nó de interrupção."""
    if state["status"] == "PENDENTE_APROVACAO_HUMANA":
        return "human_gate"
    return END

# 7. MONTAGEM E COMPILAÇÃO DO GRAFO
workflow = StateGraph(ReembolsoState)

# Adicionando os nós ao grafo
workflow.add_node("agent", no_agente_analisador)
workflow.add_node("validar_politica", no_validar_politica)
workflow.add_node("human_gate", no_aprovacao_humana)

