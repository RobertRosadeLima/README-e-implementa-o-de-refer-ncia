def carregar_dados_auditoria():
    """Conecta ao Postgres e extrai as métricas de rotas e eficiência."""
    conn = psycopg2.connect(DB_URI)
    
    # Query 1: Distribuição de Rotas
    q_rotas = """
    SELECT 
        (checkpoint->'values'->>'status')::varchar AS status_final,
        COUNT(*) AS total
    FROM checkpoints
    WHERE (checkpoint->'values'->>'status') IS NOT NULL
    GROUP BY status_final;
    """
    df_rotas = pd.read_sql(q_rotas, conn)
    
