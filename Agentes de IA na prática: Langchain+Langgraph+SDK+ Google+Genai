    q_roi = """
    SELECT 
        TO_CHAR((checkpoint->'metadata'->>'ts')::timestamp, 'YYYY-MM') AS mes,
        COUNT(*) * 15.00 AS custo_manual,
        COUNT(*) * 0.05 AS custo_gemini
    FROM checkpoints
    GROUP BY mes ORDER BY mes;
    """
    df_roi = pd.read_sql(q_roi, conn)
    
