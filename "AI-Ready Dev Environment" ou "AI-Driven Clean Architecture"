class ChromaVectorRepository(VectorRepositoryProtocol):
    """Implementação real utilizando o banco de vetores ChromaDB rodando localmente"""
    def __init__(self):
        # 1. Configura a função de embedding local (roda 100% na sua máquina sem custos)
        self.embedding_fn = embedding_functions.SentenceTransformerEmbeddingFunction(
            model_name="all-MiniLM-L6-v2"
        )
        
        # 2. Inicializa o cliente do ChromaDB (salvando os dados na pasta .chroma_data)
        self.chroma_client = chromadb.PersistentClient(path=".chroma_data")
        
        # 3. Cria ou obtém a coleção de documentos
        self.collection = self.chroma_client.get_or_create_collection(
            name="knowledge_base",
            embedding_function=self.embedding_fn
        )
        
        # Semeia a base se ela estiver vazia para o nosso exemplo funcionar
        if self.collection.count() == 0:
            self._seed_database()

    def _seed_database(self):
        """Alimenta o banco de vetores com os documentos da empresa corporativa"""
        self.collection.add(
            documents=[
                "A política de reembolso da nossa empresa garante até 30 dias de devolução integral para planos anuais.",
                "Assinaturas mensais canceladas antes do dia 15 não sofrem cobrança no mês subsequente.",
                "O suporte técnico atende via chat das 08:00 às 18:00 em dias úteis.",
                "Desenvolvedores juniores têm direito a um orçamento anual de R$ 2.000 para cursos e livros."
            ],
            metadatas=[
                {"source": "faq_financeiro.pdf"},
                {"source": "termos_uso.pdf"},
                {"source": "recursos_humanos.pdf"},
                {"source": "treinamentos.pdf"}
            ],
            ids=["doc1", "doc2", "doc3", "doc4"]
        )

    def search_relevant_chunks(self, query: str, limit: int = 3) -> list[TextChunk]:
        """Realiza a busca semântica real por distância cosseno / L2 no banco de vetores"""
        results = self.collection.query(
            query_texts=[query],
            n_results=limit
        )

        chunks = []
        # O ChromaDB retorna listas aninhadas, mapeamos os resultados para entidades do Core
        if results["documents"] and results["documents"][0]:
            for i in range(len(results["documents"][0])):
                content = results["documents"][0][i]
                metadata = results["metadatas"][0][i]
                # O Chroma retorna distâncias (menor é melhor). Convertemos para um score simulado.
                distance = results["distances"][0][i] if results["distances"] else 0.0
                score = max(0.0, 1.0 - distance)

                chunks.append(TextChunk(
                    content=content,
                    source_document=metadata.get("source", "unknown"),
                    score=score
                ))
        return chunks


