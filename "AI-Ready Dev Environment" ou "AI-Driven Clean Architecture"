def process_rag_query(self, question: str) -> dict:
    """Task que executa o RAG e persiste os dados de auditoria no Banco de Dados"""
    task_id = self.request.id
    db: Session = SessionLocal()
    
    # 1. Cria o registro inicial de auditoria
    db_record = AIRecordModel(
        task_id=task_id,
        question=question,
        status="PROCESSING"
    )
    db.add(db_record)
    db.commit()

    try:
        # 2. Inicializa e executa os serviços da Clean Architecture
        vector_repo = ChromaVectorRepository()
        llm_service = OpenAILLMService()
        use_case = AskAIWithContextUseCase(vector_repo=vector_repo, llm_service=llm_service)
        
        result = use_case.execute(question=question)
        
        # Mapeia fontes para estrutura em dicionário pura
        sources_list = [
            {
                "content": s.content,
                "source_document": s.source_document,
                "score": s.score
            } for s in result.sources
        ]

        # 3. Atualiza o registro no banco com Sucesso e os dados retornados
        db_record.answer = result.answer
        db_record.sources_json = json.dumps(sources_list)
        db_record.status = "SUCCESS"
        db.commit()
        
        return {
            "answer": result.answer,
            "sources": sources_list
        }
        
    except Exception as e:
        # 4. Caso dê erro, atualiza a auditoria marcando a falha
