from typing import Protocol
from src.core.entities import TextChunk, AIResponse

class VectorRepositoryProtocol(Protocol):
    def search_relevant_chunks(self, query: str, limit: int = 3) -> list[TextChunk]:
        ...

class LLMServiceProtocol(Protocol):
    def generate_answer(self, question: str, context_chunks: list[TextChunk]) -> str:
        ...

class AskAIWithContextUseCase:
    def __init__(self, vector_repo: VectorRepositoryProtocol, llm_service: LLMServiceProtocol):
        self.vector_repo = vector_repo
        self.llm_service = llm_service

    def execute(self, question: str) -> AIResponse:
        if not question.strip():
            raise ValueError("A pergunta não pode estar vazia.")

        # 1. Recupera o contexto relevante do banco de vetores (RAG)
        chunks = self.vector_repo.search_relevant_chunks(query=question, limit=3)
        
        # 2. Envia para o LLM gerar a resposta baseada exclusivamente no contexto
        answer = self.llm_service.generate_answer(question=question, context_chunks=chunks)
        
        return AIResponse(answer=answer, sources=chunks)

