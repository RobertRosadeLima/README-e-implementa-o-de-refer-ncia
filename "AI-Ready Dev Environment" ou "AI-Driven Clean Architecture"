class SQLAlchemyUserRepository:
    """Implementação concreta que satisfaz UserRepositoryProtocol usando SQLAlchemy"""
    def __init__(self, db: Session):
        self.db = db

    def save(self, user: User) -> User:
        # Mapeia a Entidade Pura do Core para o Modelo do ORM
        db_user = UserModel(
            id=user.id,
            name=user.name,
            email=user.email,
            is_active=user.is_active
        )
        self.db.add(db_user)
        self.db.commit()
        self.db.refresh(db_user)
        return user

    def exists_by_email(self, email: str) -> bool:
        return self.db.query(UserModel).filter(UserModel.email == email).first() is not None

