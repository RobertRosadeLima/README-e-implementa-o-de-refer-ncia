class OpenAILLMService(LLMServiceProtocol):
    """Implementação real utilizando o SDK da OpenAI"""
    def __init__(self):
        # O cliente busca automaticamente a variável de ambiente OPENAI_API_KEY
        self.api_key = os.getenv("OPENAI_API_KEY")
        if not self.api_key:
            raise ValueError("A variável de ambiente OPENAI_API_KEY não foi configurada.")
        
        self.client = OpenAI(api_key=self.api_key)

    def generate_answer(self, question: str, context_chunks: list[TextChunk]) -> str:
        # 1. Consolida os blocos de texto retornados pelo RAG em uma única string de contexto
        context_text = "\n\n".join([
            f"Trecho de [{c.source_document}]: {c.content}" 
            for c in context_chunks
        ])

        # 2. Desenha o prompt de sistema blindando a IA de alucinações (System Prompt)
        system_prompt = (
            "Você é um assistente virtual corporativo especializado e prestativo.\n"
            "Sua tarefa é responder à pergunta do usuário baseando-se estritamente no contexto fornecido abaixo.\n"
            "Se o contexto não contiver a informação necessária para responder, diga educadamente que não sabe.\n\n"
            f"--- CONTEXTO DO PROJETO ---\n{context_text}\n---------------------------"
        )

        try:
            # 3. Executa a chamada utilizando a API moderna da OpenAI
            response = self.client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": question}
                ],
                temperature=0.0  # Temperatura zero garante respostas determinísticas e fiéis ao contexto
            )
            return response.choices[0].message.content
        except Exception as e:
            # Em sistemas reais, adicione logs estruturados aqui
            raise RuntimeError(f"Falha na comunicação com o provedor de LLM: {str(e)}")

