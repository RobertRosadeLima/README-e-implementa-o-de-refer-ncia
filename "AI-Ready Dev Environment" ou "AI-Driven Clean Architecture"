from src.infra.celery_app import celery_app
from src.core.use_cases import AskAIWithContextUseCase
from src.infra.ai_services import MockVectorRepository, MockLLMService

@celery_app.task(bind=True, name="tasks.process_rag_query")
def process_rag_query(self, question: str) -> dict:
    """Task executada em background pelo worker do Celery"""
    # Injeção de dependências dentro do ambiente isolado do worker
    vector_repo = MockVectorRepository()
    llm_service = MockLLMService()
    use_case = AskAIWithContextUseCase(vector_repo=vector_repo, llm_service=llm_service)
    
    try:
        # Atualiza o status para processando (opcional para feedback em tempo real)
        self.update_state(state="PROCESSING")
        
        # Executa o caso de uso puro do core
        result = use_case.execute(question=question)
        
        # Retorna um dicionário serializável em JSON para o backend do Celery
        return {
            "answer": result.answer,
            "sources": [
                {
                    "content": s.content,
                    "source_document": s.source_document,
                    "score": s.score
                } for s in result.sources
            ]
        }
    except Exception as e:
        # Trata falhas e marca a task como falha no banco de dados
        self.update_state(state="FAILURE", meta={"error": str(e)})
        raise e

