        const API_URL = "http://127.0.0.1:8000";
        let poolingInterval = null;

        async function submitQuery() {
            const questionInput = document.getElementById("question").value;
            const sendBtn = document.getElementById("sendBtn");
            const statusContainer = document.getElementById("statusContainer");
            const responseContainer = document.getElementById("responseContainer");
            const progressBar = document.getElementById("progressBar");
            const statusText = document.getElementById("statusText");
            const taskLabel = document.getElementById("taskLabel");

            if (!questionInput.trim()) return alert("Por favor, digite uma pergunta.");

            // Reset UI
            sendBtn.disabled = true;
            sendBtn.classList.add("opacity-50");
            responseContainer.classList.add("hidden");
            statusContainer.classList.remove("hidden");
            progressBar.style.width = "10%";
            statusText.innerText = "Enviando requisição...";

            try {
                // 1. Dispara a requisição assíncrona
                const res = await fetch(`${API_URL}/ai/ask-async`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ question: questionInput })
                });

                if (!res.ok) throw new Error("Erro ao iniciar a tarefa de IA.");

                const data = await res.json();
                const taskId = data.task_id;
                
                taskLabel.innerText = `ID: ${taskId.substring(0, 8)}...`;
                progressBar.style.width = "30%";
                statusText.innerText = "Na fila do Celery...";

                // 2. Inicia o mecanismo de Pooling para checar o status no Redis
                startPooling(taskId);

            } catch (err) {
                alert(err.message);
                resetUI();
            }
        }

        function startPooling(taskId) {
            const progressBar = document.getElementById("progressBar");
            const statusText = document.getElementById("statusText");

            poolingInterval = setInterval(async () => {
                try {
                    const res = await fetch(`${API_URL}/ai/tasks/${taskId}`);
                    const data = await res.json();

                    if (data.status === "PROCESSING") {
                        statusText.innerText = "OpenAI gerando resposta...";
                        progressBar.style.width = "60%";
                    } 
                    else if (data.status === "SUCCESS") {
                        clearInterval(poolingInterval);
                        progressBar.style.width = "100%";
                        statusText.innerText = "Concluído!";
                        displayResult(data.result);
                    } 
                    else if (data.status === "FAILURE") {
                        clearInterval(poolingInterval);
                        statusText.innerText = "Erro no processamento.";
                        alert(`Erro na Task: ${data.error}`);
                        resetUI();
                    }
                } catch (err) {
                    console.error("Erro no pooling:", err);
                }
            }, 1500); // Consulta o status a cada 1.5 segundos
        }

        function displayResult(result) {
            const sendBtn = document.getElementById("sendBtn");
            const responseContainer = document.getElementById("responseContainer");
            const aiAnswer = document.getElementById("aiAnswer");
            const ragSources = document.getElementById("ragSources");

            aiAnswer.innerText = result.answer;
            ragSources.innerHTML = "";

            result.sources.forEach(source => {
                const div = document.createElement("div");
                div.className = "p-3 bg-gray-750 border border-gray-700 rounded-lg text-xs flex justify-between items-center";
                div.innerHTML = `
                    <div>
                        <span class="text-indigo-400 font-medium">[${source.source_document}]</span> 
                        <p class="text-gray-400 mt-1">"${source.content}"</p>
                    </div>
                    <span class="text-emerald-400 font-mono font-bold bg-emerald-950/50 px-2 py-1 rounded ml-2">
                        ${(source.score * 100).toFixed(0)}%
                    </span>
                `;
                ragSources.appendChild(div);
            });

            responseContainer.classList.remove("hidden");
            sendBtn.disabled = false;
            sendBtn.classList.remove("opacity-50");
        }

        function resetUI() {
            document.getElementById("sendBtn").disabled = false;
            document.getElementById("sendBtn").classList.remove("opacity-50");
            document.getElementById("statusContainer").classList.add("hidden");
        }
    </script>
