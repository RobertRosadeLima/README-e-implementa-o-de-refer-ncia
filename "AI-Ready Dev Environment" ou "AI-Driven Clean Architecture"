from typing import Protocol
from src.core.entities import User

# Definimos um Protocolo (Interface) para o repositório. 
# O Core não sabe qual banco de dados usamos, apenas que ele precisa salvar.
class UserRepositoryProtocol(Protocol):
    def save(self, user: User) -> User:
        ...
    def exists_by_email(self, email: str) -> bool:
        ...

class CreateUserUseCase:
    def __init__(self, repository: UserRepositoryProtocol):
        self.repository = repository

    def execute(self, name: str, email: str) -> User:
        if self.repository.exists_by_email(email):
            raise ValueError("Este e-mail já está cadastrado.")

        new_user = User(name=name, email=email)
        new_user.validate()
        
        return self.repository.save(new_user)

from src.core.entities import User

class MemoryUserRepository:
    """Implementação em memória (simulando um banco de dados)"""
    def __init__(self):
