import streamlit as st
import google.genai as genai
import pandas as pd
import io

# 1. CONFIGURAÇÃO DA PÁGINA WEB
st.set_page_config(page_title="FinAI - Automação Financeira", page_icon="💰", layout="wide")

st.title("💰 FinAI - Analisador e Gerador de Planilhas Financeiras com IA")
st.markdown("Cole sua lista de gastos bagunçada e deixe que a IA organize, categorize e gere sua planilha do Excel automaticamente!")

# 2. CONEXÃO SEGURA COM A IA
try:
    CHAVE_SEGURA = st.secrets["GEMINI_API_KEY"]
    client = genai.Client(api_key=CHAVE_SEGURA)
except Exception:
    st.error("❌ Erro de Configuração: A chave 'GEMINI_API_KEY' não foi encontrada nas Secrets.")
    st.stop()

# 3. INTERFACE VISUAL
st.subheader("📝 Cole seus gastos abaixo")
st.caption("Exemplo: 'Comprei R\$ 50 de gasolina ontem, gastei 120 no mercado na quinta e 35 no ifood hoje'")
texto_gastos = st.text_area("Descreva seus gastos do mês de forma livre:", height=150)

# 4. BOTÃO DE PROCESSAMENTO E AUTOMAÇÃO
if st.button("Categorizar Gastos e Gerar Planilha 🚀"):
    if texto_gastos.strip():
        with st.spinner("🤖 A IA está analisando, limpando e categorizando seus gastos..."):
            
            # Prompt exigindo dados em formato CSV para facilitar a automação via Pandas
            prompt_financas = f"""
            Você é um analista financeiro sênior e especialista em engenharia de dados.
            Analise o seguinte texto livre de gastos e extraia cada item listando: Descrição, Categoria (use apenas: Alimentação, Transporte, Lazer, Saúde, Moradia ou Outros) e Valor (apenas o número, usando ponto para decimais).

            Sua resposta deve ser EXCLUSIVAMENTE uma tabela no formato CSV legítimo, utilizando a vírgula (,) como separador de colunas. Não inclua nenhuma outra palavra, introdução, markdown (como ```csv) ou explicação. A primeira linha deve ser o cabeçalho.
            
            Cabeçalho obrigatório:
            Descricao,Categoria,Valor

            Texto dos gastos:
            {texto_gastos}
            """
            
            try:
                resposta = client.models.generate_content(
                    model='gemini-2.5-flash',
                    contents=prompt_financas,
                )
                
                # Remove espaços em branco ou blocos de código markdown residuais da resposta da IA
                dados_csv = resposta.text.strip().replace("```csv", "").replace("```", "")
                
                # ---- ENGENHARIA DE DADOS TRADICIONAL (Conversão de String para DataFrame) ----
                # Usamos io.StringIO para fazer o Pandas ler o texto puro como se fosse um arquivo de verdade
                df_gastos = pd.read_csv(io.StringIO(dados_csv))
                
                # Garante que a coluna Valor seja tratada como número de verdade
                df_gastos['Valor'] = pd.to_numeric(df_gastos['Valor'], errors='coerce')
                df_gastos = df_gastos.dropna() # Remove linhas que deram erro
                
                # 5. EXIBIÇÃO DOS RESULTADOS (Métricas, Gráficos e Tabelas)
                st.success("🎉 Seus dados foram automatizados com sucesso!")
                
                col_met, col_graf = st.columns([1, 2])
                
                with col_met:
                    st.markdown("### 📊 Resumo do Mês")
                    total_gasto = df_gastos['Valor'].sum()
                    st.metric("Total de Gastos", f"R$ {total_gasto:.2f}")
                    
                    st.markdown("#### Tabela Organizada")
                    st.dataframe(df_gastos, use_container_width=True, hide_index=True)
                
                with col_graf:
                    st.markdown("### 📈 Gastos por Categoria")
                    # Agrupa os valores por categoria para gerar o gráfico
                    df_categorias = df_gastos.groupby('Categoria')['Valor'].sum().reset_index()
                    
                    # Gera um gráfico de barras nativo e interativo
                    st.bar_chart(data=df_categorias, x='Categoria', y='Valor', use_container_width=True)
                
                # ---- 6. EXPORTAÇÃO AUTOMATIZADA PARA EXCEL/CSV ----
                st.markdown("---")
                st.subheader("📥 Baixar Sua Planilha Pronta")
                
                # Converte o DataFrame limpo de volta para uma string CSV pronta para download
                csv_para_baixar = df_gastos.to_csv(index=False).encode('utf-8')
                
                st.download_button(
                    label="📥 Baixar Planilha para o Excel (.csv)",
                    data=csv_para_baixar,
                    file_name="meu_planejamento_finai.csv",
                    mime="text/csv"
                )
                
            except Exception as e:
                st.error(f"Erro ao processar e automatizar os dados financeiros: {e}. Certifique-se de colar os gastos em um formato legível.")
    else:
        st.warning("⚠️ Por favor, digite ou cole algum gasto para analisar.")

